// tsconfig.app.json — perímetro de PRODUCCIÓN. Solo `src` sin sus tests.
//
// EL GATE REAL ES `bun run typecheck`, que ejecuta `tsc -b` (modo build con
// referencias). NO uses `bunx tsc --noEmit` ni `tsc -p <config>` como señal
// verde: el tsconfig.json raíz referencia proyectos y uno suelto no equivale.
// Esto vivía solo en CLAUDE.md:253, a 250 líneas del fichero que protege.
//
// Los tests y `scripts/` NO entran aquí a propósito: tienen su propio proyecto
// en tsconfig.tests.json, referenciado desde la raíz, para que `tsc -b` los
// cubra SIN ensanchar el contrato de producción. Si un test necesita una API
// más moderna, se amplía el `lib` de AQUEL, no el de este: de lo contrario
// mañana alguien usa esa API en `src/` y compila porque se la habilitó un
// script.
{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}